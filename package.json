{
  "name": "atlyn-scatter",
  "version": "1.0.0",
  "private": true,
  "description": "Certification-first explainable quadrant scatter visual for Power BI",
  "main": "dist/visual.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist-tests/tests/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:full": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "package": "npm run clean && npm run build && pbiviz package && node scripts/normalize-pbiviz.cjs",
    "reproducibility-audit": "node scripts/reproducibility-audit.cjs",
    "certification-audit": "npm run clean && npm test && npm run typecheck && npm run lint:full && npm run reproducibility-audit && pbiviz lint && node scripts/certification-audit.cjs && npm run publication-audit && npm run release-manifest && npm run audit",
    "publication-audit": "node scripts/publication-audit.cjs",
    "generate-brand-assets": "node scripts/generate-brand-assets.cjs",
    "generate-sample-report": "node scripts/generate-sample-report.cjs",
    "screenshots": "node scripts/generate-screenshots.cjs",
    "release-manifest": "node scripts/release-manifest.cjs",
    "audit": "npm audit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('dist-tests',{recursive:true,force:true})\""
  },
  "dependencies": {
    "powerbi-visuals-api": "^5.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.39.1",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "globals": "^15.14.0",
    "jszip": "3.10.1",
    "powerbi-visuals-tools": "^7.2.1",
    "typescript": "^5.8.3",
    "write-file-atomic": "5.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "hono": "^4.12.34",
    "uuid": "^11.1.1"
  }
}
