                  "Property": "Product"
                }
              },
              "queryRef": "ProductPerformance.Product",
              "nativeQueryRef": "Product"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "ProductPerformance"
                        }
                      },
                      "Property": "Gross margin %"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Average(ProductPerformance.Gross margin %)",
              "nativeQueryRef": "Average of Gross margin %"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "ProductPerformance"
                        }
                      },
                      "Property": "Revenue growth %"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Average(ProductPerformance.Revenue growth %)",
              "nativeQueryRef": "Average of Revenue growth %"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "ProductPerformance"
                        }
                      },
                      "Property": "Revenue"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(ProductPerformance.Revenue)",
              "nativeQueryRef": "Sum of Revenue"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ProductPerformance"
                    }
                  },
                  "Property": "Region"
                }
              },
              "queryRef": "ProductPerformance.Region",
              "nativeQueryRef": "Region"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Margin and growth by product and region'"
