{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "visualSeriesBreakdown",
  "position": {
    "x": 40,
    "y": 40,
    "z": 0,
    "height": 800,
    "width": 1520,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "atlynScatter",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ProductPerformance"
